# Gemini API key — get one at https://aistudio.google.com
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-3.6-flash

# Server
HOST=127.0.0.1
PORT=8000

# Database (PostgreSQL — single source of truth, replaces SQLite file)
DATABASE_URL=postgresql://studyreel:password@db:5432/studyreel
# Cloudinary — CDN for rendered PNG slides (leave empty until you have credentials)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Ollama fallback (optional) — Set this only if running Ollama on the same host as the backend. Leave unset in cloud deployments.
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:7b

# Phase 2 publish pipeline
# Publisher target: "instaclone" (default, local mini-Instagram) or "instagram" (Phase 3 real Meta API)
PUBLISHER=instaclone
# InstaClone app base URL (P3's standalone feed app, port 8100)
INSTACLONE_URL=http://127.0.0.1:8100
# Publisher SQLite path (published/scheduled posts + simulated OAuth token)
PUBLISHER_DB=studyreel_publisher.db

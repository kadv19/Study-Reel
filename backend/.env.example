# Gemini API key — get one at https://aistudio.google.com
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-3.6-flash

# Server
HOST=127.0.0.1
PORT=8000

# Database (PostgreSQL — single source of truth, replaces SQLite file)
DATABASE_URL=postgresql://studyreel:password@db:5432/studyreel
# Cloudinary — CDN for rendered PNG slides (leave empty until you have credentials)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Rendex — hosted HTML→PNG rendering (free tier 500 renders/month)
RENDEX_API_KEY=rdx_your_key_here
# OpenAI-compatible fallback after all Gemini models fail (Groq by default)
FALLBACK_BASE_URL=https://api.groq.com/openai/v1
FALLBACK_API_KEY=
FALLBACK_MODEL=llama-3.3-70b-versatile

# Ollama fallback (optional) — only used when set to a non-localhost host
# after the Groq-compatible fallback also fails.
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:7b

# Phase 2 publish pipeline
# Publisher target: "instaclone" (default, local mini-Instagram) or "instagram" (Phase 3 real Meta API)
PUBLISHER=instaclone
# InstaClone app base URL (P3's standalone feed app, port 8100)
INSTACLONE_URL=http://127.0.0.1:8100
# On Render, set this to the deployed instaclone service URL, e.g. https://studyreel-instaclone.onrender.com
# Publisher SQLite path (published/scheduled posts + simulated OAuth token)
PUBLISHER_DB=studyreel_publisher.db
